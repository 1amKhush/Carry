# Copy to .env.turso.local inside apps/api for explicit local Turso commands.
# Render uses its service Environment settings instead of this file.
TURSO_DATABASE_URL=libsql://your-libsql-database.turso.io
TURSO_AUTH_TOKEN=replace-with-your-database-token

# Optional server-only key for free AI. Use a fresh, private key; never expose it in Vite.
CARRY_OPENROUTER_FREE_KEY=
