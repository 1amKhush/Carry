{
  "id": "/",
  "name": "Carry",
  "short_name": "Carry",
  "description": "Carry a page and its context to your paired device.",
  "start_url": "/#new",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f7f8f2",
  "theme_color": "#eeefe7",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
